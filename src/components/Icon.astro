---
const icons = import.meta.glob('/node_modules/lucide-static/icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;

interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 18, class: className = '' } = Astro.props;
const raw = icons[`/node_modules/lucide-static/icons/${name}.svg`];
if (!raw) throw new Error(`Ícone não encontrado: ${name}`);
const svg = raw
  .replace(/<!--.*?-->/s, '')
  .replace(/width="24"/, `width="${size}"`)
  .replace(/height="24"/, `height="${size}"`)
  .replace(/class="[^"]*"/, `class="icon ${className}" aria-hidden="true" focusable="false"`);
---
<Fragment set:html={svg} />
