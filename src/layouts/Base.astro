---
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { routes, ui, t, type Lang, type RouteKey } from '../i18n';
import { profile } from '../data/profile';

interface Props {
  lang: Lang;
  page: RouteKey;
  title?: string;
  description: string;
}
const { lang, page, title, description } = Astro.props;
const other: Lang = lang === 'pt' ? 'en' : 'pt';
const site = Astro.site!;
const fullTitle = title ? `${title} · ${profile.name}` : `${profile.name} · ${t(profile.role, lang)}`;
const canonical = new URL(routes[page][lang], site).href;
const navKeys = ['research', 'projects', 'leadership', 'cv'] as const;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.fullName,
  alternateName: profile.name,
  url: site.href,
  image: new URL(profile.photo, site).href,
  jobTitle: t(profile.role, lang),
  affiliation: { '@type': 'CollegeOrUniversity', name: 'Universidade Federal de Alagoas' },
  sameAs: profile.links.map((l) => l.url),
};
---
<!doctype html>
<html lang={lang === 'pt' ? 'pt-BR' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pt-BR" href={new URL(routes[page].pt, site).href} />
    <link rel="alternate" hreflang="en" href={new URL(routes[page].en, site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(routes[page].pt, site).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#faf9f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1015" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(profile.photo, site).href} />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var s = localStorage.getItem('theme');
          if (s === 'light' || s === 'dark') d.setAttribute('data-theme', s);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t(ui.skip, lang)}</a>
    <header class="site-header" id="site-header">
      <div class="container header-inner">
        <a class="brand" href={routes.home[lang]}>Victor Samyr<span>.</span></a>
        <nav class="nav" id="nav" aria-label={lang === 'pt' ? 'Principal' : 'Main'}>
          {navKeys.map((k) => (
            <a href={routes[k][lang]} aria-current={page === k ? 'page' : undefined}>{t(ui.nav[k], lang)}</a>
          ))}
        </nav>
        <div class="header-tools">
          <a class="lang-btn" href={routes[page][other]} hreflang={other} lang={other} title={t(ui.switchLang, lang)} aria-label={t(ui.switchLang, lang)}>
            {t(ui.switchLangShort, lang)}
          </a>
          <button class="icon-btn theme-btn" id="theme-btn" type="button" aria-label={t(ui.toggleTheme, lang)} title={t(ui.toggleTheme, lang)}>
            <span class="moon"><Icon name="moon" size={16} /></span>
            <span class="sun"><Icon name="sun" size={16} /></span>
          </button>
          <button class="icon-btn menu-btn" id="menu-btn" type="button" aria-controls="nav" aria-expanded="false" aria-label={t(ui.openMenu, lang)}>
            <Icon name="menu" size={18} />
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p>© {new Date().getFullYear()} {profile.fullName}</p>
        <ul class="pill-links">
          <li><a href={`mailto:${profile.email}`}>Email</a></li>
          {profile.links.map((l) => <li><a href={l.url} rel="me noopener" target="_blank">{l.label}</a></li>)}
        </ul>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      const themeBtn = document.getElementById('theme-btn');
      themeBtn?.addEventListener('click', () => {
        const current =
          root.getAttribute('data-theme') ??
          (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch {}
      });

      const menuBtn = document.getElementById('menu-btn');
      const nav = document.getElementById('nav');
      menuBtn?.addEventListener('click', () => {
        const open = nav!.classList.toggle('open');
        menuBtn.setAttribute('aria-expanded', String(open));
      });

      const header = document.getElementById('site-header');
      const onScroll = () => header?.classList.toggle('scrolled', scrollY > 8);
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }),
        { rootMargin: '0px 0px -8% 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
